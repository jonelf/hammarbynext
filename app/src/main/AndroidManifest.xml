<?xml version="1.0" encoding="utf-8"?>
<!-- INTERNET: spelschemat från ESPN, vädret från Netatmo, och bevakningen av VMA och Polisen (se WatchService). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Bevakningen (WatchService): notiser ovanpå andra appar, en förgrundstjänst och start vid uppstart. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false">

        <!-- Nästa match under klockan på cleanyourtv:s Home, när game_day i launcherns config.xml är
             se.hammarbynext.tv (kontraktet i cleanyourtv:s docs/modules.md). Läsbar för alla: bara det Home visar. -->
        <meta-data android:name="com.gathin.tvhome.games" android:value="se.hammarbynext.tv.games" />
        <!-- Vädret från Netatmo bredvid matchen, när info_panel i launcherns config.xml är se.hammarbynext.tv. -->
        <meta-data android:name="com.gathin.tvhome.info" android:value="se.hammarbynext.tv.games" />
        <provider
            android:name=".GamesProvider"
            android:authorities="se.hammarbynext.tv.games"
            android:exported="true" />

        <!-- Rutan i app-listan och kortet på cleanyourtv:s Home (docs/modules.md): samma vy direkt, tills Back. -->
        <activity
            android:name=".NextMatchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Skärmsläckaren: Inställningar > Enhetsinställningar > Skärmsläckare > Hammarby nästa match. -->
        <service
            android:name=".NextMatchDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- VMA och Polisens händelser i Stockholm, som notis ovanpå det som syns. -->
        <!-- Startbar från adb (testnotiserna i README), men inte av andra appar: DUMP har bara skalet och systemet. -->
        <service
            android:name=".WatchService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Bevakar VMA och Polisens händelser och visar dem som notis på TV:n" />
        </service>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
